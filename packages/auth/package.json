{
  "name": "@wishbeam/auth",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./permissions": "./src/permissions.ts",
    "./service": "./src/service.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "NODE_ENV=development vpx auth@latest generate --config ./generated/config.ts --output ./generated/auth-schema.ts --yes"
  },
  "devDependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "@types/node": "catalog:",
    "@wishbeam/config": "workspace:*",
    "@wishbeam/db": "workspace:*",
    "@wishbeam/typescript-config": "workspace:*",
    "better-auth": "catalog:",
    "effect": "catalog:"
  }
}
